{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Maciker/geospatial-quality-explorer/blob/main/quality/schemas/post-pr-review-input.schema.json",
  "title": "Portable post-PR review input",
  "type": "object",
  "required": [
    "pr",
    "current",
    "diff",
    "checks",
    "review"
  ],
  "properties": {
    "pr": {
      "type": "object",
      "required": [
        "number",
        "url",
        "baseSha",
        "headSha"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "baseSha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      },
      "additionalProperties": true
    },
    "current": {
      "type": "object",
      "required": [
        "baseSha",
        "headSha"
      ],
      "properties": {
        "baseSha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      }
    },
    "diff": {
      "type": "object",
      "required": [
        "complete",
        "baseSha",
        "headSha"
      ],
      "properties": {
        "complete": {
          "const": true
        },
        "baseSha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "digest": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "required": [
        "status",
        "items"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "none",
            "pending",
            "failed"
          ]
        },
        "requiredCount": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array"
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "decision",
        "reviewer",
        "implementer"
      ],
      "properties": {
        "decision": {
          "enum": [
            "pass",
            "iterate",
            "stop"
          ]
        },
        "reviewer": {
          "type": "object"
        },
        "implementer": {
          "type": "object"
        },
        "findings": {
          "type": "array"
        },
        "blocking_findings": {
          "type": "array"
        },
        "non_blocking_findings": {
          "type": "array"
        },
        "missing_tests": {
          "type": "array"
        }
      }
    },
    "publication": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "published",
            "pending",
            "failed"
          ]
        },
        "url": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        }
      }
    }
  }
}
