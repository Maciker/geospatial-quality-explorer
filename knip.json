{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": ["tsx"],
  "workspaces": {
    ".": {
      "entry": [
        "tools/**/*.mjs",
        "test/**/*.test.ts",
        "playwright.config.ts",
        "test/global-setup.ts"
      ],
      "project": [
        "tools/**/*.mjs",
        "test/**/*.ts",
        "playwright.config.ts"
      ]
    },
    "apps/*": {
      "entry": [
        "src/main.{ts,tsx}",
        "vite.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "vite.config.ts"
      ]
    },
    "packages/*": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
