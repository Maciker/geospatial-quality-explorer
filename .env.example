# Reference values only. Nothing loads this file automatically: export the
# variables in your shell (or your host's settings) before running commands.

# PostGIS used by `pnpm gis`, `pnpm dev:api` and the integration tests.
# Unset: the CLI validates without storing and the API keeps runs in memory.
GEOSPATIAL_POSTGIS_URL=postgres://explorer:explorer@127.0.0.1:5432/geospatial_quality_explorer

# API bind (loopback only) and port. Vite proxies /api to 127.0.0.1:8000.
# HOST=127.0.0.1
# PORT=8000

# Alexa+ simulation. Without NAN_API_KEY the deterministic mock answers and
# the UI shows "Model: deterministic mock". Never commit a real key.
# NAN_API_KEY=
# NAN_BASE_URL=https://api.nan.builders/v1
# NAN_MODEL=qwen3.6
# ALEXA_SIM_MOCK_LLM=deterministic        # force the mock even with a key (CI, tests)
# ALEXA_SIM_CORS_ORIGINS=https://your-demo.vercel.app
# ALEXA_SIM_RATE_LIMIT_PER_MINUTE=20      # per client and per server instance
# ALEXA_SIM_TIMEOUT_MS=45000             # whole POST budget; capped at 55000 (Vercel maxDuration 60 s)
# ALEXA_SIM_ROUND_TIMEOUT_MS=24000       # per-LLM-call cap (also limited by remaining turn budget)
# ALEXA_SIM_MAX_TOOL_ROUNDS=4
# ALEXA_SIM_MAX_TOKENS=1024
# ALEXA_SIM_ENABLE_THINKING=0            # set 1 to allow provider thinking (default off for latency)
# ALEXA_SIM_DISABLE_THINKING=0           # set 1 to send chat_template_kwargs to a non-NaN provider that accepts it

# Web build (Vite exposes only VITE_* to the browser; never put secrets here).
# VITE_APP_MODE=alexa-only                # hosted build: simulation only (set in vercel.json)
# VITE_API_BASE_URL=                      # empty: same-origin /api

# Agent workflow: implementer identity is declared explicitly; AI_* configures only the QA harness.
# QA_REQUIRE_HARNESS=1 requires reviewer identity from qa:run.
